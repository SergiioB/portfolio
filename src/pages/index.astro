---
import { getCollection } from "astro:content";

import AsciiTopology from "../components/AsciiTopology.astro";
import ExecutiveSidebar from "../components/ExecutiveSidebar.astro";
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const posts = await getCollection("posts");
const publishedPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postUrl = (slug: string) => withBase(`posts/${slug}/`);

const labFamilies = [
  {
    model: "Nemotron 3.5 Lightning",
    engine: "vLLM XPU · GPTQ-INT4 · DFlash n=7",
    value: "186.6",
    unit: "t/s",
    claim: "C1 client post-first · p2048/g128 · n=5 · 150 W",
    note: "Not isolated prefill. Cold input 7160 is prompt/TTFT.",
    href: postUrl("nemotron-35-lightning-dflash-arc-pro-b70"),
  },
  {
    model: "Muse Glimmer-30B",
    engine: "llama.cpp SYCL · Q4_K_XL · DFlash n2",
    value: "26.8",
    unit: "t/s",
    claim: "C1 engine decode · p512/g128 · 128K · 230 W",
    note: "Public path. vLLM overlay is experimental and slower.",
    href: postUrl("muse-glimmer-30b-intel-arc-b70"),
  },
  {
    model: "Qwen3.6-35B-A3B",
    engine: "llama.cpp SYCL · Q4_K_XL",
    value: "70",
    unit: "t/s",
    claim: "C1 decode · MoE · 512K context class",
    note: "Prefill 1659 t/s at the published pp4096 cell.",
    href: postUrl("intel-arc-pro-b70-full-recipe-llama-cpp-sycl"),
  },
  {
    model: "KV cache",
    engine: "llama.cpp · q8_0 K + q4_1 V",
    value: "0.003",
    unit: "KL",
    claim: "Near-lossless vs FP16 KV · ~50% VRAM",
    note: "q4_0 K is catastrophic (KLD ~5.5). Do not use it.",
    href: postUrl("kv-cache-quantization-kl-divergence"),
  },
];

const shelves = [
  {
    family: "Nemotron",
    logo: "images/logos/nvidia.png",
    kicker: "vLLM XPU · 3B-active LatentMoE",
    title: "186.6 t/s C1 with DFlash, not native MTP",
    lede: "Graphs plus a BF16 DFlash draft. Native MTP still accepts 0%. Speed card is 16K n=5; capacity completed 119,904 tokens. Not 128K.",
    href: postUrl("nemotron-35-lightning-dflash-arc-pro-b70"),
    posts: [
      {
        title: "Nemotron + DFlash on B70",
        href: postUrl("nemotron-35-lightning-dflash-arc-pro-b70"),
      },
      {
        title: "vLLM vs llama.cpp showdown (earlier Qwen stack)",
        href: postUrl("intel-arc-b70-vllm-vs-llamacpp-moe-dense-showdown"),
      },
    ],
  },
  {
    family: "Muse Glimmer",
    logo: "images/logos/meta.png",
    kicker: "llama.cpp SYCL · dense multimodal",
    title: "26.8 t/s at 128K — vLLM is not the public path",
    lede: "DFlash n2 wins the GGUF sweep. The 29.2 number is 64K. INT4 vLLM exists only as a local overlay.",
    href: postUrl("muse-glimmer-30b-intel-arc-b70"),
    posts: [
      {
        title: "Muse Glimmer-30B recipe",
        href: postUrl("muse-glimmer-30b-intel-arc-b70"),
      },
      {
        title: "Full llama.cpp SYCL recipe",
        href: postUrl("intel-arc-pro-b70-full-recipe-llama-cpp-sycl"),
      },
    ],
  },
  {
    family: "Qwen",
    logo: "images/logos/qwen.png",
    kicker: "llama.cpp SYCL · dense 27B + MoE 35B",
    title: "The living recipe, then the 27B MTP card",
    lede: "Qwen numbers stay on their own posts. Do not mix them with Nemotron client-TTFT or DFlash cells.",
    href: postUrl("intel-arc-pro-b70-full-recipe-llama-cpp-sycl"),
    posts: [
      {
        title: "B70 full recipe (MoE 35B)",
        href: postUrl("intel-arc-pro-b70-full-recipe-llama-cpp-sycl"),
      },
      {
        title: "ThinkingCap 27B + MTP",
        href: postUrl("qwen3-27b-thinkingcap-b70-full-recipe"),
      },
      {
        title: "MTP spec-token curve",
        href: postUrl("intel-arc-b70-mtp-spec-token-curve"),
      },
    ],
  },
  {
    family: "Methods",
    logo: "images/logos/intel.png",
    kicker: "KV · power · context ceilings",
    title: "Why q8_0 K + q4_1 V, and what 32 GB actually holds",
    lede: "Methodology posts. These are not model speed cards.",
    href: postUrl("kv-cache-quantization-kl-divergence"),
    posts: [
      {
        title: "KV cache KL-divergence",
        href: postUrl("kv-cache-quantization-kl-divergence"),
      },
      {
        title: "Context ceilings on 32 GB",
        href: postUrl("b70-kv-cache-quantization-context-ceilings"),
      },
      {
        title: "Quantized-KV prefill (+140% at 32K)",
        href: postUrl("intel-arc-b70-sycl-xmx-quantized-kv-prefill"),
      },
    ],
  },
];

const shelfHrefs = new Set(shelves.flatMap((shelf) => shelf.posts.map((item) => item.href)));
const remainingPosts = publishedPosts.filter((post) => !shelfHrefs.has(postUrl(post.slug)));
---

<BaseLayout
  title={`${SITE.author} | Linux, AI Infrastructure & Product Engineering`}
  description={SITE.description}
  layoutMode="executive"
>
  <div class="executive-home">
    <ExecutiveSidebar currentPath={Astro.url.pathname} />

    <main class="executive-main home-fieldbook">
      <section class="field-hero" aria-labelledby="home-heading">
        <div class="field-hero-copy">
          <p class="field-kicker">
            <span>SYS.01</span>
            <span data-i18n="exec.heroKicker">Systems engineering · local AI · product</span>
          </p>
          <h1 id="home-heading" data-i18n="exec.heroTitle">Linux infra, local AI, shipped apps.</h1>
          <p class="field-hero-lede" data-i18n="exec.heroLede">
            Enterprise Linux operations, LLM inference on Intel Arc Pro B70, and production Android
            apps — documented with the trade-offs left in.
          </p>
          <div class="field-hero-actions">
            <a class="field-button field-button-primary" href={withBase("archive/")}>
              <span data-i18n="exec.exploreNotes">Explore field notes</span><span aria-hidden="true"
                >↗</span
              >
            </a>
          </div>
        </div>

        <AsciiTopology />
      </section>

      <section class="field-section lab-section" aria-labelledby="lab-heading">
        <header class="field-section-header">
          <div>
            <span class="field-section-index">01</span>
            <div>
              <p>Local AI Lab</p>
              <h2 id="lab-heading">One GPU, measured to the token.</h2>
            </div>
          </div>
          <p>
            Intel Arc Pro B70 32GB. Each card is one engine, one model, one cell — not a blended
            leaderboard.
          </p>
        </header>

        <div class="lab-grid">
          {
            labFamilies.map((card) => (
              <a class="lab-stat" href={card.href}>
                <span class="lab-stat-model">{card.model}</span>
                <span class="lab-stat-value">
                  {card.value}
                  <em> {card.unit}</em>
                </span>
                <span class="lab-stat-label">{card.claim}</span>
                <span class="lab-stat-sub">{card.engine}</span>
                <span class="lab-stat-note">{card.note}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="field-section" aria-labelledby="apps-heading">
        <header class="field-section-header">
          <div>
            <span class="field-section-index">02</span>
            <div>
              <p data-i18n="exec.productionApps">Production Apps</p>
              <h2 id="apps-heading" data-i18n="exec.appsHeading">
                Useful software, not AI wrappers.
              </h2>
            </div>
          </div>
          <p data-i18n="exec.appsIntro">
            Two privacy-minded Android products built around local-first value and resilient cloud
            boundaries.
          </p>
        </header>

        <div class="product-grid">
          <article class="product-card product-card-auto">
            <div class="product-card-topline">
              <span>ANDROID / VEHICLE OPS</span>
              <span class="product-status"
                ><i></i><span data-i18n="exec.livePlay">Live on Play Store</span></span
              >
            </div>
            <div class="product-card-body">
              <img
                class="product-icon"
                src={withBase("images/apps/intelliauto-icon.webp")}
                alt="IntelliAuto app icon"
                decoding="async"
              />
              <div class="product-card-text">
                <h3>IntelliAuto</h3>
                <p data-i18n="exec.intelliautoDesc">
                  Vehicle management. AutoMind AI, ML Kit OCR, offline encrypted storage.
                </p>
              </div>
            </div>
            <div class="product-stack" aria-label="Technology stack">
              <span>Kotlin</span><span>Firebase</span><span>Offline-first</span><span>ML Kit</span>
            </div>
            <div class="product-card-actions">
              <a
                href="https://play.google.com/store/apps/details?id=com.barrysoft.intelliauto"
                target="_blank"
                rel="noopener noreferrer"
                ><span data-i18n="exec.playStore">Play Store</span><span aria-hidden="true">↗</span
                ></a
              >
              <a href="https://intelliauto.app" target="_blank" rel="noopener noreferrer"
                >intelliauto.app<span aria-hidden="true">↗</span></a
              >
            </div>
          </article>

          <article class="product-card product-card-flow">
            <div class="product-card-topline">
              <span>ANDROID / FINANCE OPS</span>
              <span class="product-status"
                ><i></i><span data-i18n="exec.livePlay">Live on Play Store</span></span
              >
            </div>
            <div class="product-card-body">
              <img
                class="product-icon"
                src={withBase("images/apps/intelliflow-icon.png")}
                alt="IntelliFlow app icon"
                decoding="async"
              />
              <div class="product-card-text">
                <h3>IntelliFlow</h3>
                <p data-i18n="exec.intelliflowDesc">
                  Finance tracker. Offline-first, cloud sync, budget projections, spending
                  summaries.
                </p>
              </div>
            </div>
            <div class="product-stack" aria-label="Technology stack">
              <span>Kotlin</span><span>Firebase</span><span>Privacy-first</span><span
                >Forecasting</span
              >
            </div>
            <div class="product-card-actions">
              <a
                href="https://play.google.com/store/apps/details?id=com.intelliflow.finances"
                target="_blank"
                rel="noopener noreferrer"
                ><span data-i18n="exec.playStore">Play Store</span><span aria-hidden="true">↗</span
                ></a
              >
              <a href="https://barrysoft-intelliflow.work" target="_blank" rel="noopener noreferrer"
                >intelliflow.work<span aria-hidden="true">↗</span></a
              >
            </div>
          </article>
        </div>
      </section>

      <section class="handbook-feature" aria-labelledby="handbook-heading">
        <div class="handbook-mark" aria-hidden="true">
          <span>┌──────┐</span>
          <span>│ LLM │</span>
          <span>└──┬───┘</span>
          <span> └─ read()</span>
        </div>
        <div class="handbook-copy">
          <p><span>03</span> <span data-i18n="exec.educationalSeries">Educational Series</span></p>
          <h2 id="handbook-heading" data-i18n="exec.handbookTitle">
            The LLM Infrastructure Handbook
          </h2>
          <p data-i18n="exec.handbookDesc">
            An engineer's guide to Local AI. Demystifying Transformer architectures, KV cache
            quantization, modern attention and MoE routing.
          </p>
        </div>
        <a class="handbook-link" href={withBase("handbook/")}>
          <span data-i18n="exec.readHandbook">Read the Handbook</span>
          <span aria-hidden="true">↗</span>
        </a>
      </section>

      <section class="field-section notes-section" aria-labelledby="notes-heading">
        <header class="field-section-header notes-heading-row">
          <div>
            <span class="field-section-index">04</span>
            <div>
              <h2 id="notes-heading" data-i18n="exec.labShelves">Local LLM Recipes</h2>
            </div>
          </div>
          <a class="field-text-link" href={withBase("b70/")}>
            <span>{publishedPosts.filter((post) => post.data.category.includes("b70")).length}</span
            >
            <span data-i18n="exec.viewB70">B70 index</span>
            <span aria-hidden="true">↗</span>
          </a>
        </header>

        <div class="family-shelf-grid">
          {
            shelves.map((shelf) => (
              <article class="family-shelf">
                <a class="family-shelf-hero" href={shelf.href}>
                  <span class="family-shelf-logo">
                    <img src={withBase(shelf.logo)} alt="" loading="lazy" decoding="async" />
                  </span>
                  <span class="family-shelf-kicker">{shelf.kicker}</span>
                  <h3>{shelf.family}</h3>
                  <p class="family-shelf-title">{shelf.title}</p>
                  <p>{shelf.lede}</p>
                </a>
                <ul class="family-shelf-list">
                  {shelf.posts.map((item) => (
                    <li>
                      <a href={item.href}>
                        <span>{item.title}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>

        <p class="family-shelf-trademark" data-i18n="exec.trademark">
          Brand logos are trademarks of their respective owners; shown for identification.
        </p>
      </section>

      <section class="field-section notes-section" aria-labelledby="more-heading">
        <header class="field-section-header">
          <div>
            <span class="field-section-index">05</span>
            <div>
              <p data-i18n="exec.morePosts">Rest of posts</p>
              <h2 id="more-heading" data-i18n="exec.morePostsHeading">More field notes</h2>
            </div>
          </div>
        </header>

        <div class="note-list">
          {
            remainingPosts.map((post, index) => (
              <a href={postUrl(post.slug)} class="note-row">
                <span class="note-row-index">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                  <h3>{post.data.title}</h3>
                </div>
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>

        <p class="family-shelf-archive">
          <a class="field-text-link" href={withBase("archive/")}>
            <span>{publishedPosts.length}</span>
            <span data-i18n="exec.viewArchive">Full chronological archive</span>
            <span aria-hidden="true">↗</span>
          </a>
        </p>
      </section>
    </main>
  </div>
</BaseLayout>
