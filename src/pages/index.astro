---
import { getCollection } from "astro:content";

import { SITE } from "../config/site";
import { CATEGORY_META, CATEGORY_ORDER, categoryMatches } from "../content/categories";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const posts = await getCollection("posts");
const publishedPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = publishedPosts.slice(0, 6);
const categoryCounts = CATEGORY_ORDER.map((category) => ({
  slug: category,
  label: CATEGORY_META[category].label,
  description: CATEGORY_META[category].description,
  count: publishedPosts.filter((post) => categoryMatches(post.data.category, category)).length,
})).filter((c) => c.count > 0);
---

<BaseLayout
  title=`${SITE.author} | Linux & Virtualization Engineering Portfolio`
  description={SITE.description}
>
  <!-- 1. HERO SECTION -->
  <section class="hero" style="margin-bottom: 2rem;">
    <h1
      class="hero-title"
      style="font-size: 2.2rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.02em; color: var(--heading);"
    >
      Sergio Barrientos
    </h1>
    <p
      class="hero-description"
      style="font-size: 1.1rem; color: var(--text-soft); max-width: 600px; line-height: 1.6;"
    >
      Linux & Virtualization Engineer at Deutsche Pfandbriefbank AG.<br />
      Building enterprise infrastructure by day; developing local AI architectures and Kotlin production
      apps by night.
    </p>
    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <a
        href="https://www.linkedin.com/in/sergio-barrientose/"
        target="_blank"
        class="btn btn-primary"
        style="padding: 0.5rem 1rem; font-size: 0.9rem;">LinkedIn Profile</a
      >
      <a
        href="/docs/cv-sergio-barrientos.html"
        target="_blank"
        class="btn"
        style="padding: 0.5rem 1rem; font-size: 0.9rem; border: 1px solid var(--border);"
        >Curriculum Vitae</a
      >
    </div>
  </section>

  <!-- 2. PRODUCTION APPS -->
  <section style="margin-bottom: 3rem;">
    <h2
      style="font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1.5rem;"
    >
      Apps in Production
    </h2>
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem;"
    >
      <div
        style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column;"
      >
        <div
          style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;"
        >
          <h3 style="font-size: 1.3rem; font-weight: 600; margin: 0; color: var(--heading);">
            IntelliAuto
          </h3>
          <span
            style="font-size: 0.7rem; padding: 0.2rem 0.5rem; background: var(--surface); color: #7ee787; border-radius: 4px; border: 1px solid rgba(126,231,135,0.2);"
            >Live on Google Play</span
          >
        </div>
        <p
          style="color: var(--text-soft); font-size: 0.9rem; flex-grow: 1; margin: 0 0 1rem 0; line-height: 1.5;"
        >
          Vehicle & garage operations platform. Local-first architecture featuring an AI Mechanic
          (AutoMind), ML Kit OCR for documents, and offline encrypted storage.
        </p>
        <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
          <span style="font-size: 0.75rem; color: #58a6ff; font-family: var(--font-mono);"
            >Kotlin</span
          >
          <span style="font-size: 0.75rem; color: #ffa20e; font-family: var(--font-mono);"
            >Firebase</span
          >
          <span style="font-size: 0.75rem; color: #d2a8ff; font-family: var(--font-mono);"
            >DeepSeek AI</span
          >
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <a
            href="https://play.google.com/store/apps/details?id=com.barrysoft.intelliauto"
            target="_blank"
            style="font-size: 0.85rem; color: var(--heading); text-decoration: underline; text-underline-offset: 4px;"
            >Google Play ↗</a
          >
          <span style="color: var(--border);">|</span>
          <a
            href="https://intelliauto.app"
            target="_blank"
            style="font-size: 0.85rem; color: var(--text-muted); text-decoration: none;"
            >intelliauto.app</a
          >
        </div>
      </div>

      <div
        style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column;"
      >
        <div
          style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;"
        >
          <h3 style="font-size: 1.3rem; font-weight: 600; margin: 0; color: var(--heading);">
            IntelliFlow
          </h3>
          <span
            style="font-size: 0.7rem; padding: 0.2rem 0.5rem; background: var(--surface); color: #7ee787; border-radius: 4px; border: 1px solid rgba(126,231,135,0.2);"
            >Live on Google Play</span
          >
        </div>
        <p
          style="color: var(--text-soft); font-size: 0.9rem; flex-grow: 1; margin: 0 0 1rem 0; line-height: 1.5;"
        >
          Privacy-first personal finance tracker. Offline-first design with best-effort cloud sync,
          budget projections, and an automated AI financial copilot.
        </p>
        <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
          <span style="font-size: 0.75rem; color: #58a6ff; font-family: var(--font-mono);"
            >Kotlin</span
          >
          <span style="font-size: 0.75rem; color: #ffa20e; font-family: var(--font-mono);"
            >Firebase</span
          >
          <span style="font-size: 0.75rem; color: #d2a8ff; font-family: var(--font-mono);"
            >DeepSeek AI</span
          >
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <a
            href="https://play.google.com/store/apps/details?id=com.intelliflow.finances"
            target="_blank"
            style="font-size: 0.85rem; color: var(--heading); text-decoration: underline; text-underline-offset: 4px;"
            >Google Play ↗</a
          >
          <span style="color: var(--border);">|</span>
          <a
            href="https://barrysoft-intelliflow.org"
            target="_blank"
            style="font-size: 0.85rem; color: var(--text-muted); text-decoration: none;"
            >barrysoft-intelliflow.org</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- 3. THE LLM HANDBOOK BANNER -->
  <section style="margin-bottom: 3rem;">
    <a href="/handbook" style="display: block; text-decoration: none;">
      <div
        style="background: var(--surface); border: 1px solid rgba(88,166,255,0.3); border-radius: var(--radius-lg); padding: 2rem; position: relative; overflow: hidden; transition: border-color 0.3s ease;"
      >
        <span
          style="font-family: var(--font-mono); font-size: 0.75rem; color: #58a6ff; text-transform: uppercase; letter-spacing: 0.1em;"
          >Educational Series</span
        >
        <h2 style="font-size: 1.8rem; font-weight: 700; color: var(--heading); margin: 0.5rem 0;">
          The LLM Infrastructure Handbook
        </h2>
        <p style="color: var(--text-soft); font-size: 1rem; max-width: 500px; margin: 0;">
          A systems engineer's guide to Local AI. Demystifying Transformer architectures, KV Cache
          quantization, Flash Attention, and MoE routing.
        </p>
        <div
          style="margin-top: 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem; color: #58a6ff; font-weight: 600; font-size: 0.9rem;"
        >
          Read the Handbook <span style="font-family: var(--font-mono);">→</span>
        </div>
      </div>
    </a>
  </section>

  <!-- 4. FIELD NOTES (DENSE LIST) & FILTERS -->
  <section>
    <div
      style="display: flex; justify-content: space-between; align-items: end; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem;"
    >
      <h2
        style="font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin: 0;"
      >
        Recent Field Notes
      </h2>
      <a
        href="/archive"
        style="font-size: 0.85rem; color: var(--text-muted); text-decoration: none;"
        >View Archive →</a
      >
    </div>

    <!-- Category Pills -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
      {
        categoryCounts.map((cat) => (
          <a
            href={withBase(`${cat.slug}/`)}
            style={`padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; text-decoration: none; border: 1px solid var(--border); background: var(--surface); color: var(--category-${cat.slug}); transition: all 0.2s ease;`}
          >
            {cat.label}{" "}
            <span style="opacity: 0.5; font-size: 0.7rem; margin-left: 0.2rem;">{cat.count}</span>
          </a>
        ))
      }
    </div>

    <!-- Dense List -->
    <div style="display: flex; flex-direction: column;">
      {
        latestPosts.map((post) => {
          const url = withBase(`posts/${post.data.slug ?? post.id.replace(/\.md$/, "")}/`);
          const date = post.data.pubDate.toLocaleDateString("en-US", {
            month: "short",
            day: "2-digit",
          });
          return (
            <a
              href={url}
              style="display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--border); text-decoration: none; transition: background 0.2s ease;"
              class="dense-post-row"
            >
              <time style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted); min-width: 50px; padding-top: 0.15rem;">
                {date}
              </time>
              <div style="display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; flex: 1;">
                <h3 style="font-size: 1rem; font-weight: 500; color: var(--text-strong); margin: 0; line-height: 1.4; word-wrap: break-word;">
                  {post.data.title}
                </h3>
                <span
                  style={`font-family: var(--font-mono); font-size: 0.65rem; color: var(--category-${post.data.category}); text-transform: uppercase; letter-spacing: 0.05em; align-self: flex-start;`}
                >
                  {post.data.category}
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- Domains -->
  <section class="section domains-section">
    <div class="section-header">
      <h2 class="section-title" data-i18n="domains.title">Domains</h2>
      <a href={withBase("archive/")} class="section-link" data-i18n="domains.browseAll"
        >Browse all</a
      >
    </div>

    <div class="domains-grid">
      {
        categoryCounts.map((category) => (
          <a href={withBase(`${category.slug}/`)} class="card domain-card">
            <div class="domain-header">
              <span class={`badge category-${category.slug}`} data-i18n={`cat.${category.slug}`}>
                {category.label}
              </span>
              <span class="domain-count">{category.count}</span>
            </div>
            <p class="domain-description" data-i18n={`cat.${category.slug}.desc`}>
              {category.description}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- GitHub Projects -->
  <section class="section github-section">
    <div class="section-header">
      <h2 class="section-title" data-i18n="home.projectsTitle">Featured Projects</h2>
      <a
        href="https://github.com/SergiioB"
        class="section-link"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="home.viewGithub">View GitHub →</a
      >
    </div>

    <div class="projects-grid">
      <a
        href="https://github.com/SergiioB/llamacpp-workbench"
        class="card project-card"
        target="_blank"
        rel="noopener noreferrer"
      >
        <h3 class="card-title">llamacpp-workbench</h3>
        <p class="card-meta" data-i18n="home.projectWorkbenchDesc">
          Local LLM inference workbench for RK3588 and edge devices
        </p>
        <span class="badge badge-accent">Python · JavaScript</span>
      </a>
      <div class="card project-card">
        <h3 class="card-title">IntelliAuto</h3>
        <p class="card-meta" data-i18n="home.projectIntelliAutoDesc">
          Vehicle & mechanic operations platform with AI diagnostics
        </p>
        <span class="badge badge-warm">Kotlin · Firebase · Production</span>
      </div>
      <div class="card project-card">
        <h3 class="card-title">IntelliFlow</h3>
        <p class="card-meta" data-i18n="home.projectIntelliflowDesc">
          AI-powered personal finance app with offline-first architecture
        </p>
        <span class="badge badge-warm">Flutter · Production</span>
      </div>
      <div class="card project-card">
        <h3 class="card-title" data-i18n="home.projectAnsibleTitle">Ansible Playbooks</h3>
        <p class="card-meta" data-i18n="home.projectAnsibleDesc">
          Infrastructure automation for enterprise Linux environments
        </p>
        <span class="badge badge-accent">Ansible · YAML</span>
      </div>
    </div>
  </section>
</BaseLayout>
