---
import { getCollection } from "astro:content";

import AsciiTopology from "../components/AsciiTopology.astro";
import ExecutiveSidebar from "../components/ExecutiveSidebar.astro";
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const posts = await getCollection("posts");
const publishedPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const selectedPosts = publishedPosts.slice(0, 6);
const featuredPost = selectedPosts[0];
const supportingPosts = selectedPosts.slice(1);

const postUrl = (post: (typeof publishedPosts)[number]) =>
  withBase(`posts/${post.data.slug ?? post.id.replace(/\.md$/, "")}/`);
const categoryToClass = (category: string) =>
  `post-category-${category
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")}`;
---

<BaseLayout
  title={`${SITE.author} | Linux, AI Infrastructure & Product Engineering`}
  description={SITE.description}
  layoutMode="executive"
>
  <div class="executive-home">
    <ExecutiveSidebar currentPath={Astro.url.pathname} />

    <main class="executive-main home-fieldbook">
      <section class="field-hero" aria-labelledby="home-heading">
        <div class="field-hero-copy">
          <p class="field-kicker">
            <span>SYS.01</span>
            <span data-i18n="exec.heroKicker">Systems engineering · local AI · product</span>
          </p>
          <h1 id="home-heading" data-i18n="exec.heroTitle">
            I build systems that stay understandable under pressure.
          </h1>
          <p class="field-hero-lede" data-i18n="exec.heroLede">
            Enterprise Linux operations, local inference experiments and production Android apps,
            documented with the trade-offs left in.
          </p>
          <div class="field-hero-actions">
            <a class="field-button field-button-primary" href={withBase("archive/")}>
              <span data-i18n="exec.exploreNotes">Explore field notes</span><span aria-hidden="true"
                >↗</span
              >
            </a>
            <a class="field-button" href={withBase("about/")}>
              <span data-i18n="exec.viewProfile">Profile + CV</span><span aria-hidden="true">→</span
              >
            </a>
          </div>
          <div class="field-proof" aria-label="Areas of work">
            <span
              ><i></i><strong data-i18n="exec.proofEnterprise">Enterprise operations</strong></span
            >
            <span><i></i><strong data-i18n="exec.proofLocal">Local AI lab</strong></span>
            <span><i></i><strong data-i18n="exec.proofProducts">Shipped software</strong></span>
          </div>
        </div>

        <AsciiTopology />
      </section>

      <section class="field-section" aria-labelledby="apps-heading">
        <header class="field-section-header">
          <div>
            <span class="field-section-index">01</span>
            <div>
              <p data-i18n="exec.productionApps">Production Apps</p>
              <h2 id="apps-heading" data-i18n="exec.appsHeading">
                Useful software, not AI wrappers.
              </h2>
            </div>
          </div>
          <p data-i18n="exec.appsIntro">
            Two privacy-minded Android products built around local-first value and resilient cloud
            boundaries.
          </p>
        </header>

        <div class="product-grid">
          <article class="product-card product-card-auto">
            <div class="product-card-topline">
              <span>ANDROID / VEHICLE OPS</span>
              <span class="product-status"
                ><i></i><span data-i18n="exec.livePlay">Live on Play Store</span></span
              >
            </div>
            <div class="product-card-body">
              <img
                class="product-icon"
                src={withBase("images/apps/intelliauto-icon.webp")}
                alt="IntelliAuto app icon"
                decoding="async"
              />
              <div class="product-card-text">
                <h3>IntelliAuto</h3>
                <p data-i18n="exec.intelliautoDesc">
                  Vehicle management. AutoMind AI, ML Kit OCR, offline encrypted storage.
                </p>
              </div>
            </div>
            <div class="product-stack" aria-label="Technology stack">
              <span>Kotlin</span><span>Firebase</span><span>Offline-first</span><span>ML Kit</span>
            </div>
            <div class="product-card-actions">
              <a
                href="https://play.google.com/store/apps/details?id=com.barrysoft.intelliauto"
                target="_blank"
                rel="noopener noreferrer"
                ><span data-i18n="exec.playStore">Play Store</span><span aria-hidden="true">↗</span
                ></a
              >
              <a href="https://intelliauto.app" target="_blank" rel="noopener noreferrer"
                >intelliauto.app<span aria-hidden="true">↗</span></a
              >
            </div>
          </article>

          <article class="product-card product-card-flow">
            <div class="product-card-topline">
              <span>ANDROID / FINANCE OPS</span>
              <span class="product-status"
                ><i></i><span data-i18n="exec.livePlay">Live on Play Store</span></span
              >
            </div>
            <div class="product-card-body">
              <img
                class="product-icon"
                src={withBase("images/apps/intelliflow-icon.png")}
                alt="IntelliFlow app icon"
                decoding="async"
              />
              <div class="product-card-text">
                <h3>IntelliFlow</h3>
                <p data-i18n="exec.intelliflowDesc">
                  Finance tracker. Offline-first, cloud sync, budget projections, spending
                  summaries.
                </p>
              </div>
            </div>
            <div class="product-stack" aria-label="Technology stack">
              <span>Kotlin</span><span>Firebase</span><span>Privacy-first</span><span
                >Forecasting</span
              >
            </div>
            <div class="product-card-actions">
              <a
                href="https://play.google.com/store/apps/details?id=com.intelliflow.finances"
                target="_blank"
                rel="noopener noreferrer"
                ><span data-i18n="exec.playStore">Play Store</span><span aria-hidden="true">↗</span
                ></a
              >
              <a href="https://barrysoft-intelliflow.work" target="_blank" rel="noopener noreferrer"
                >intelliflow.work<span aria-hidden="true">↗</span></a
              >
            </div>
          </article>
        </div>
      </section>

      <section class="handbook-feature" aria-labelledby="handbook-heading">
        <div class="handbook-mark" aria-hidden="true">
          <span>┌──────┐</span>
          <span>│ LLM │</span>
          <span>└──┬───┘</span>
          <span> └─ read()</span>
        </div>
        <div class="handbook-copy">
          <p><span>02</span> <span data-i18n="exec.educationalSeries">Educational Series</span></p>
          <h2 id="handbook-heading" data-i18n="exec.handbookTitle">
            The LLM Infrastructure Handbook
          </h2>
          <p data-i18n="exec.handbookDesc">
            An engineer's guide to Local AI. Demystifying Transformer architectures, KV cache
            quantization, modern attention and MoE routing.
          </p>
        </div>
        <a class="handbook-link" href={withBase("handbook/")}>
          <span data-i18n="exec.readHandbook">Read the Handbook</span>
          <span aria-hidden="true">↗</span>
        </a>
      </section>

      <section class="field-section notes-section" aria-labelledby="notes-heading">
        <header class="field-section-header notes-heading-row">
          <div>
            <span class="field-section-index">03</span>
            <div>
              <p data-i18n="exec.recentNotes">Recent Field Notes</p>
              <h2 id="notes-heading" data-i18n="exec.notesHeading">
                Measured, failed, fixed, documented.
              </h2>
            </div>
          </div>
          <a class="field-text-link" href={withBase("archive/")}>
            <span>{publishedPosts.length}</span>
            <span data-i18n="exec.viewArchive">View Full Archive</span>
            <span aria-hidden="true">↗</span>
          </a>
        </header>

        {
          featuredPost && (
            <div class="notes-layout">
              <a href={postUrl(featuredPost)} class="featured-note">
                <div class="featured-note-meta">
                  <span data-i18n="exec.latestSignal">Latest signal</span>
                  <time
                    datetime={featuredPost.data.pubDate.toISOString()}
                    data-localize-date="long"
                  >
                    {featuredPost.data.pubDate.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </time>
                </div>
                <h3>{featuredPost.data.title}</h3>
                <p>{featuredPost.data.description}</p>
                <div class="featured-note-footer">
                  <div class="executive-category-pills">
                    {featuredPost.data.category.map((category) => (
                      <span class:list={["post-category", categoryToClass(category)]}>
                        {category}
                      </span>
                    ))}
                  </div>
                  <span aria-hidden="true">READ ↗</span>
                </div>
              </a>

              <div class="note-list">
                {supportingPosts.map((post, index) => (
                  <a href={postUrl(post)} class="note-row">
                    <span class="note-row-index">{String(index + 2).padStart(2, "0")}</span>
                    <div>
                      <time datetime={post.data.pubDate.toISOString()} data-localize-date="short">
                        {post.data.pubDate.toLocaleDateString("en-US", {
                          month: "short",
                          day: "numeric",
                        })}
                      </time>
                      <h3>{post.data.title}</h3>
                      <div class="executive-category-pills">
                        {post.data.category.map((category) => (
                          <span class:list={["post-category", categoryToClass(category)]}>
                            {category}
                          </span>
                        ))}
                      </div>
                    </div>
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </section>
    </main>
  </div>
</BaseLayout>
