---
import { withBase } from "../utils/paths";

const cvEn = withBase("docs/cv-sergio-barrientos.pdf");
const cvEs = withBase("docs/cv-sergio-barrientos-es.pdf");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Redirecting CV...</title>
    <noscript><meta http-equiv="refresh" content={`0;url=${cvEn}`} /></noscript>
    <script is:inline define:vars={{ cvEn, cvEs }}>
      (function () {
        let lang = new URLSearchParams(window.location.search).get("lang");
        if (lang !== "en" && lang !== "es") {
          try {
            lang = window.localStorage.getItem("portfolio.lang");
          } catch (_) {
            /* Storage can be unavailable in private browsing. */
          }
        }
        if (lang !== "en" && lang !== "es") {
          lang = (navigator.language || "").toLowerCase().startsWith("es") ? "es" : "en";
        }

        window.location.replace(lang === "es" ? cvEs : cvEn);
      })();
    </script>
  </head>
  <body>
    <p>Redirecting to CV...</p>
    <p>
      <a href={cvEn}>Open English CV</a>
      |
      <a href={cvEs}>Abrir CV en español</a>
    </p>
  </body>
</html>
