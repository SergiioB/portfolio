---
import { getCollection } from "astro:content";

import ExecutiveSidebar from "../components/ExecutiveSidebar.astro";
import PostSearch from "../components/PostSearch.astro";
import { SITE } from "../config/site";
import { CATEGORY_META, CATEGORY_ORDER } from "../content/categories";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const posts = await getCollection("posts");
const sortedPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const b70Count = sortedPosts.filter((p) => p.data.category.includes("b70")).length;
const countFor = (slug: string) => sortedPosts.filter((p) => p.data.category.includes(slug)).length;

const postsByYear = sortedPosts.reduce(
  (acc, post) => {
    const year = post.data.pubDate.getFullYear();
    if (!acc[year]) acc[year] = [];
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, typeof sortedPosts>
);

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title={`Archive | ${SITE.author}`}
  description="Chronological archive of technical case studies."
  layoutMode="executive"
>
  <div class="executive-home">
    <ExecutiveSidebar currentPath={Astro.url.pathname} />
    <main class="executive-main">
      <section>
        <h2
          style="font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); border-bottom: 1px solid var(--border); padding-bottom: 0.55rem; margin: 0 0 1.25rem;"
        >
          <span data-i18n="archive.eyebrow">Archive</span>
        </h2>
        <h1
          style="font-size: 1.5rem; font-weight: 700; color: var(--heading); margin: 0 0 0.5rem;"
          data-i18n="archive.title"
        >
          All Case Studies
        </h1>
        <p style="color: var(--text-soft); font-size: 0.9rem; margin: 0 0 1.5rem;">
          {sortedPosts.length}
          <span data-i18n="archive.description"
            >posts grouped by year, each with clear issue and solution framing.</span
          >
        </p>
      </section>

      <section class="archive-browse" aria-label="Browse by category">
        <a class="b70-hub" href={withBase("b70/")}>
          <img
            src={withBase("images/diagrams/gpu-offload-bandwidth-cliff.svg")}
            alt="Intel Arc Pro B70 GPU bandwidth diagram"
            loading="lazy"
          />
          <div class="b70-hub-text">
            <strong data-i18n="b70hub.title">Intel Arc B70</strong>
            <span
              >{b70Count}
              <span data-i18n="b70hub.desc"
                >case studies · llama.cpp SYCL, KV cache, MoE benchmarks</span
              ></span
            >
          </div>
          <span class="b70-hub-arrow" aria-hidden="true">→</span>
        </a>

        <div
          class="archive-filter"
          role="group"
          aria-label="Filter posts by category"
          data-i18n-label="archive.filterAria"
        >
          <button class="filter-chip is-active" data-filter="all" data-i18n="archive.filterAll"
            >All</button
          >
          {
            CATEGORY_ORDER.map((slug) => (
              <button class={`filter-chip ${slug}`} data-filter={slug}>
                {CATEGORY_META[slug]?.label ?? slug}
                <em>{countFor(slug)}</em>
              </button>
            ))
          }
        </div>
      </section>

      <PostSearch
        itemSelector="[data-search-item]"
        sectionSelector=".archive-year"
        placeholder="Search all posts (title, issue, solution, tags)..."
      />

      <div class="archive-content">
        {
          years.map((year) => (
            <section
              class="archive-year"
              aria-labelledby={`year-heading-${year}`}
              id={`year-${year}`}
            >
              <h2 id={`year-heading-${year}`} class="archive-year-header">
                {year}
              </h2>
              <div class="archive-posts">
                {postsByYear[year].map((post) => (
                  <article
                    class="archive-post panel panel-soft"
                    data-search-item
                    data-categories={post.data.category.join(" ")}
                    data-search={`${post.data.title} ${post.data.description} ${post.data.issue ?? ""} ${post.data.solution ?? ""} ${post.data.usedIn ?? ""} ${(post.data.tags ?? []).join(" ")} ${post.data.category.join(" ")}`}
                  >
                    <time
                      class="archive-post-date"
                      datetime={post.data.pubDate.toISOString()}
                      data-localize-date="short"
                    >
                      {post.data.pubDate.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                      })}
                    </time>

                    <div>
                      <a
                        href={withBase(`posts/${post.data.slug ?? post.id.replace(/\.md$/, "")}/`)}
                        class="archive-post-title"
                      >
                        {post.data.title}
                      </a>
                      <p class="archive-post-summary">
                        <strong data-i18n="posts.issue">Issue:</strong>{" "}
                        {post.data.issue ?? post.data.description}
                      </p>
                      {post.data.solution && (
                        <p class="archive-post-summary">
                          <strong data-i18n="posts.solution">Solution:</strong> {post.data.solution}
                        </p>
                      )}
                    </div>

                    <div class="archive-post-categories">
                      {post.data.category.map((cat, _i) => (
                        <span
                          class={`category-badge archive-post-badge ${cat}`}
                          data-i18n={`cat.${cat}`}
                        >
                          {CATEGORY_META[cat]?.label ?? cat}
                        </span>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))
        }

        {
          years.length === 0 && (
            <p class="empty-state panel panel-soft" data-i18n="posts.noPosts">
              No posts published yet.
            </p>
          )
        }
      </div>
    </main>
  </div>

  <style>
    .archive-browse {
      display: grid;
      gap: 0.9rem;
      margin-bottom: 1.4rem;
    }

    .b70-hub {
      display: grid;
      grid-template-columns: 92px minmax(0, 1fr) auto;
      gap: 0.9rem;
      align-items: center;
      padding: 0.8rem 1rem;
      border: 1px solid rgba(56, 189, 248, 0.35);
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), var(--surface));
      text-decoration: none;
      color: inherit;
      transition:
        border-color 0.2s,
        transform 0.2s;
    }

    .b70-hub:hover {
      border-color: var(--category-b70);
      transform: translateY(-2px);
    }

    .b70-hub img {
      width: 92px;
      height: 60px;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface-muted);
    }

    .b70-hub-text {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
    }

    .b70-hub-text strong {
      color: var(--category-b70);
      font-size: 0.95rem;
    }

    .b70-hub-text span {
      color: var(--text-soft);
      font-size: 0.75rem;
      font-family: var(--font-mono);
    }

    .b70-hub-arrow {
      color: var(--category-b70);
      font-size: 1.2rem;
    }

    .archive-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .filter-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.32rem 0.7rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      cursor: pointer;
      transition:
        border-color 0.2s,
        color 0.2s;
    }

    .filter-chip em {
      font-style: normal;
      opacity: 0.6;
      font-size: 0.62rem;
    }

    .filter-chip:hover,
    .filter-chip.is-active {
      color: var(--text-strong);
      border-color: var(--link);
    }

    .filter-chip.b70.is-active {
      color: var(--category-b70);
      border-color: var(--category-b70);
    }

    .archive-post.is-hidden {
      display: none;
    }

    .archive-year.is-empty {
      display: none;
    }
  </style>

  <script>
    // Event delegation on <document> so filtering works regardless of when the
    // archive DOM is mounted (Astro ViewTransitions client-side navigation does
    // not re-run is:inline scripts, which is why per-chip listeners broke).
    document.addEventListener("click", (e) => {
      const chip = e.target instanceof Element ? e.target.closest(".filter-chip") : null;
      if (!chip) return;
      const slug = chip.getAttribute("data-filter") || "all";

      document.querySelectorAll(".filter-chip").forEach((x) => {
        x.classList.toggle("is-active", x === chip);
      });

      document.querySelectorAll(".archive-post").forEach((p) => {
        const cats = (p.getAttribute("data-categories") || "").split(" ");
        const show = slug === "all" || cats.includes(slug);
        p.classList.toggle("is-hidden", !show);
      });

      document.querySelectorAll(".archive-year").forEach((y) => {
        const visible = y.querySelectorAll(".archive-post:not(.is-hidden)").length;
        y.classList.toggle("is-empty", visible === 0);
      });
    });
  </script>
</BaseLayout>
