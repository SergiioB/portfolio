---
import ExecutiveSidebar from "../components/ExecutiveSidebar.astro";
import { PUBLIC_CV, SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const publicCvHref = PUBLIC_CV.external ? PUBLIC_CV.href : withBase(PUBLIC_CV.href);
const publicCvHrefEs = PUBLIC_CV.external ? PUBLIC_CV.hrefEs : withBase(PUBLIC_CV.hrefEs);
---

<BaseLayout
  title={`About | ${SITE.author}`}
  description="AI systems and Linux infrastructure profile, XeCores research lab, experience, CV, and technical partnerships."
  layoutMode="executive"
>
  <div class="executive-home">
    <ExecutiveSidebar currentPath={Astro.url.pathname} />
    <main class="executive-main">
      <section>
        <h2
          style="font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); border-bottom: 1px solid var(--border); padding-bottom: 0.55rem; margin: 0 0 1.25rem;"
        >
          <span data-i18n="about.eyebrow">Profile</span>
        </h2>
        <h1
          style="font-size: 1.5rem; font-weight: 700; color: var(--heading); margin: 0 0 0.75rem;"
          data-i18n="about.headline"
        >
          AI Systems &amp; Linux Infrastructure Engineer — Founder of XeCores.
        </h1>
        <p
          style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.6; margin: 0 0 1.5rem;"
          data-i18n="about.intro"
        >
          By day I operate banking-grade RHEL platforms and Ansible automation. Outside work I run
          XeCores, an independent Intel Arc Pro B70 inference lab publishing reproducible recipes,
          quantized Hugging Face checkpoints, upstream runtime fixes, and local-first software.
        </p>
        <div
          class="tldr-box panel panel-soft"
          style="margin-top: 0; padding: 1.25rem; border-left: 3px solid var(--accent); margin-bottom: 2rem;"
        >
          <strong
            data-i18n="about.tldrTitle"
            style="color: var(--text-strong); display: block; margin-bottom: 0.5rem; font-family: var(--font-mono); font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.05em;"
            >TL;DR for Engineering Teams &amp; Partners</strong
          >
          <p style="margin: 0; font-size: 0.95em; color: var(--text);" data-i18n="about.tldrBody">
            I bridge regulated enterprise Linux operations (300+ RHEL servers, Ansible, VMware,
            Azure AI Foundry) with deep hands-on local AI systems work on Intel GPUs (XeCores,
            b70-launcher, 140K+ monthly Hugging Face model downloads, merged upstream contributions
            across AutoRound, TensorFold, vLLM XPU, and Cascadia). Comfortable across production
            ops, low-level benchmarking, and technical communication.
          </p>
        </div>
      </section>

      <section class="about-section" aria-labelledby="summary-title">
        <h2 id="summary-title" data-i18n="about.snapshot">Professional Snapshot</h2>
        <div class="signal-grid">
          <article class="panel panel-soft signal-card">
            <h3 data-i18n="about.infraTitle">Infrastructure lifecycle ownership</h3>
            <p data-i18n="about.infraDesc">
              RHEL migrations, Satellite lifecycle control, patch management, hardening, and HA/DR
              readiness.
            </p>
          </article>
          <article class="panel panel-soft signal-card">
            <h3 data-i18n="about.autoTitle">Automation discipline</h3>
            <p data-i18n="about.autoDesc">
              Ansible orchestration and Git-based change control for repeatable, peer-reviewed, and
              auditable operations.
            </p>
          </article>
          <article class="panel panel-soft signal-card">
            <h3 data-i18n="about.aiTitle">Local &amp; enterprise AI systems</h3>
            <p data-i18n="about.aiDesc">
              Independent Intel Arc Pro B70 inference research (XeCores, vLLM XPU, llama.cpp SYCL,
              OpenVINO, TensorFold) alongside Azure AI Foundry delivery in banking.
            </p>
          </article>
        </div>
      </section>

      <section class="about-section" aria-labelledby="experience-title">
        <h2 id="experience-title" data-i18n="about.experience">Experience</h2>
        <div class="timeline">
          <article class="timeline-item panel panel-soft">
            <div class="timeline-head">
              <div>
                <h3 data-i18n="exp.pbb.title">
                  Linux and Virtualization Engineer · Deutsche Pfandbriefbank AG
                </h3>
                <p class="timeline-subtitle" data-i18n="exp.pbb.subtitle">
                  Full-time · Hybrid · Madrid, Comunidad de Madrid, España
                </p>
              </div>
              <p class="timeline-period" data-i18n="exp.pbb.period">Jul 2025 - Present</p>
            </div>
            <ul>
              <li data-i18n="exp.pbb.0">
                Part of the Linux infrastructure team responsible for 300+ RHEL production servers
                across multiple datacenters under BaFin/ECB regulatory oversight.
              </li>
              <li data-i18n="exp.pbb.1">
                Designed Ansible + Git automation pipelines for server provisioning, configuration
                drift remediation, and lifecycle operations.
              </li>
              <li data-i18n="exp.pbb.2">
                Leading phased RHEL 7/8 to RHEL 9 migration across 300+ servers with Satellite-based
                provisioning and compliance enforcement.
              </li>
              <li data-i18n="exp.pbb.3">
                Deploying and maintaining application stacks across Nginx, Apache, Tomcat,
                JBoss/WildFly, and PostgreSQL — SSL/TLS hardening, reverse proxy tuning, and
                production optimization for banking-critical workloads.
              </li>
              <li data-i18n="exp.pbb.4">
                Owning end-to-end patching and hardening cycles for 300+ servers aligned to
                financial-sector security requirements.
              </li>
              <li data-i18n="exp.pbb.5">
                Operating Pacemaker-based HA clusters and executing disaster-recovery drills across
                distributed datacenters.
              </li>
              <li data-i18n="exp.pbb.6">
                Administering VMware vSphere environments for VM provisioning, capacity planning,
                and platform lifecycle maintenance.
              </li>
              <li data-i18n="exp.pbb.7">
                Delivering AI use cases with Azure AI Foundry — document intelligence pipelines and
                model fine-tuning for process automation.
              </li>
              <li data-i18n="exp.pbb.8">
                Acting as infrastructure consultant for application owners, translating business
                requirements into delivery plans.
              </li>
            </ul>
          </article>

          <article class="timeline-item panel panel-soft">
            <div class="timeline-head">
              <div>
                <h3 data-i18n="exp.xecores.title">Founder &amp; Lead Researcher · XeCores</h3>
                <p class="timeline-subtitle" data-i18n="exp.xecores.subtitle">
                  Independent Open-Source Lab · xecores.com · Madrid, Spain
                </p>
              </div>
              <p class="timeline-period" data-i18n="exp.xecores.period">2026 - Present</p>
            </div>
            <ul>
              <li data-i18n="exp.xecores.0">
                Built xecores.com, the intel-arc-pro-b70-inference-cookbook (200+ GitHub stars), and
                b70-launcher to provide tested, reproducible single- and dual-B70 LLM inference
                recipes across vLLM XPU, exl3xpu, TensorFold, and llama.cpp SYCL.
              </li>
              <li data-i18n="exp.xecores.1">
                Published quantized Hugging Face checkpoints exceeding 140K+ downloads/month, cited
                as reproducible baselines in upstream Intel and vLLM engineering issues.
              </li>
              <li data-i18n="exp.xecores.2">
                Contributed 40+ merged upstream PRs and low-level bug reproducers across
                intel/auto-round, intel/compute-runtime, vllm-xpu-kernels, TensorFold, Cascadia, and
                IntelInside.
              </li>
            </ul>
          </article>

          <article class="timeline-item panel panel-soft">
            <div class="timeline-head">
              <div>
                <h3 data-i18n="exp.community.title">
                  Inference Performance Engineer · Community Labs
                </h3>
                <p class="timeline-subtitle" data-i18n="exp.community.subtitle">
                  Part-time independent collaboration · Remote · Madrid, Spain
                </p>
              </div>
              <p class="timeline-period" data-i18n="exp.community.period">Sep 2026 - Present</p>
            </div>
            <ul>
              <li data-i18n="exp.community.0">
                Part-time independent collaboration focused on local AI inference infrastructure for
                Intel hardware.
              </li>
              <li data-i18n="exp.community.1">
                Working on reproducible performance evaluation, benchmarking and validation of
                inference workflows, including model/runtime configurations and
                community-contributed improvements.
              </li>
              <li data-i18n="exp.community.2">
                Supporting work around Cascadia, a distributed inference platform built on Intel
                OpenVINO.
              </li>
            </ul>
          </article>

          <article class="timeline-item panel panel-soft">
            <div class="timeline-head">
              <div>
                <h3 data-i18n="exp.sopra1.title">
                  Information Technology Application Specialist - Linux System Administrator · Sopra
                  Steria
                </h3>
                <p class="timeline-subtitle" data-i18n="exp.sopra1.subtitle">
                  Full-time · Hybrid · Madrid, Community of Madrid, Spain
                </p>
              </div>
              <p class="timeline-period" data-i18n="exp.sopra1.period">Nov 2023 - Jul 2025</p>
            </div>
            <ul>
              <li data-i18n="exp.sopra1.1">
                Led a team of 5 technicians managing 100+ Linux and Windows servers for a Norwegian
                financial client in a fully English-speaking environment.
              </li>
              <li data-i18n="exp.sopra1.2">
                Maintained RHEL compliance across 100+ servers using Red Hat Satellite; built
                Ansible automation reducing deployment time from hours to minutes.
              </li>
              <li data-i18n="exp.sopra1.3">
                Managed VMware vSphere and vCenter environments handling VM lifecycle, snapshot
                management, and capacity optimization.
              </li>
              <li data-i18n="exp.sopra1.4">
                Resolved incidents and managed change operations in ServiceNow within SLA deadlines
                with structured escalation documentation.
              </li>
              <li data-i18n="exp.sopra1.5">
                Administered Active Directory computer object lifecycle, group policies, and
                Kerberos integration for Linux servers.
              </li>
            </ul>
          </article>

          <article class="timeline-item panel panel-soft">
            <div class="timeline-head">
              <div>
                <h3 data-i18n="exp.sopra2.title">
                  Information Technology Application Specialist · Sopra Steria
                </h3>
                <p class="timeline-subtitle" data-i18n="exp.sopra2.subtitle">
                  Full-time · Madrid, Community of Madrid, Spain
                </p>
              </div>
              <p class="timeline-period" data-i18n="exp.sopra2.period">Jul 2023 - Oct 2023</p>
            </div>
            <ul>
              <li data-i18n="exp.sopra2.1">
                Delivered advanced technical support across multiple technologies in enterprise
                production contexts.
              </li>
              <li data-i18n="exp.sopra2.2">
                Contributed to cloud-transition support initiatives and workplace modernization
                programs.
              </li>
              <li data-i18n="exp.sopra2.3">
                Worked across global collaboration environments with structured escalation and
                resolution flows.
              </li>
            </ul>
          </article>

          <article class="timeline-item panel panel-soft">
            <div class="timeline-head">
              <div>
                <h3 data-i18n="exp.intern.title">Internship Trainee · Sopra Steria</h3>
                <p class="timeline-subtitle" data-i18n="exp.intern.subtitle">
                  Internship · Madrid, Community of Madrid, Spain
                </p>
              </div>
              <p class="timeline-period" data-i18n="exp.intern.period">Apr 2023 - Jun 2023</p>
            </div>
            <ul>
              <li data-i18n="exp.intern.1">
                Built foundations in incident handling, directory services, and enterprise support
                workflows.
              </li>
            </ul>
          </article>
        </div>
      </section>

      <section class="about-section" aria-labelledby="areas-title">
        <h2 id="areas-title" data-i18n="about.coreAreas">Core Areas</h2>
        <div class="skills-grid">
          <article class="skill-card panel panel-soft">
            <h3 data-i18n="skill.linux">Linux Platform Engineering</h3>
            <p data-i18n="skill.linux.desc">
              RHEL lifecycle management, troubleshooting, kernel/system tuning, and operational
              reliability practices.
            </p>
          </article>
          <article class="skill-card panel panel-soft">
            <h3 data-i18n="skill.auto">Automation &amp; Governance</h3>
            <p data-i18n="skill.auto.desc">
              Ansible playbooks, reusable role design, Git workflows, and evidence-based operational
              change controls.
            </p>
          </article>
          <article class="skill-card panel panel-soft">
            <h3 data-i18n="skill.virt">Virtualization &amp; Datacenter Ops</h3>
            <p data-i18n="skill.virt.desc">
              VMware vSphere administration, server lifecycle tasks, HA awareness, and
              disaster-recovery execution.
            </p>
          </article>
          <article class="skill-card panel panel-soft">
            <h3 data-i18n="skill.mid">App Platforms &amp; Databases</h3>
            <p data-i18n="skill.mid.desc">
              Nginx, Apache, Tomcat, JBoss/WildFly, PostgreSQL — application deployment, SSL/TLS,
              reverse proxy, and production database operations.
            </p>
          </article>
          <article class="skill-card panel panel-soft">
            <h3 data-i18n="skill.cloud">Cloud + Local AI Systems</h3>
            <p data-i18n="skill.cloud.desc">
              Azure AI Foundry, document intelligence, and local LLM inference engineering across
              Intel Arc Pro B70, vLLM XPU, llama.cpp SYCL, TensorFold, and OpenVINO.
            </p>
          </article>
          <article class="skill-card panel panel-soft">
            <h3 data-i18n="skill.team">Cross-Team Delivery</h3>
            <p data-i18n="skill.team.desc">
              Stakeholder management, technical consulting for app owners, and
              requirement-to-platform translation.
            </p>
          </article>
        </div>
      </section>

      <section class="about-section" aria-labelledby="cv-title">
        <h2 id="cv-title" data-i18n="about.cvTitle">CV / Resume</h2>
        <article class="panel panel-soft cv-card">
          <p data-i18n="about.cvDesc">
            Detailed CV is available as a PDF with role scope, delivery outcomes, and full
            technology coverage.
          </p>
          {
            PUBLIC_CV.enabled ? (
              <a
                id="cv-action-link"
                href={publicCvHref}
                data-href-en={publicCvHref}
                data-href-es={publicCvHrefEs}
                class="action-link"
                target={PUBLIC_CV.openInNewTab ? "_blank" : undefined}
                rel={PUBLIC_CV.openInNewTab ? "noopener noreferrer" : undefined}
                data-i18n="about.cvLabel"
              >
                {PUBLIC_CV.label}
              </a>
            ) : (
              <p class="cv-disabled-note" data-i18n="about.cvDisabled">
                CV link is temporarily unavailable.
              </p>
            )
          }
        </article>
      </section>

      <section class="about-section" id="partnerships" aria-labelledby="partnerships-title">
        <h2 id="partnerships-title" data-i18n="about.partnershipsTitle">
          Partnerships, Speaking &amp; Technical Advisory
        </h2>
        <article class="panel panel-soft cv-card">
          <p data-i18n="about.partnershipsDesc">
            Open to independent hardware and runtime evaluations, reproducible benchmark deep-dives,
            developer advocacy collaborations, and technical advisory around local AI inference and
            Linux infrastructure. Every sponsored or partnered piece is clearly disclosed and
            follows the same evidence-first methodology as XeCores.
          </p>
          <div class="partnerships-actions">
            <a
              href="mailto:sergiobarrientose@outlook.com?subject=Technical%20Partnership%20%2F%20Advisory%20Inquiry"
              class="action-link"
              data-i18n="about.partnershipsCta"
            >
              Contact sergiobarrientose@outlook.com ↗
            </a>
            <a
              href="https://xecores.com/"
              class="action-link"
              target="_blank"
              rel="noopener noreferrer"
              data-i18n="about.partnershipsXecores"
            >
              Explore XeCores Lab ↗
            </a>
          </div>
        </article>
      </section>

      <section class="about-section" aria-labelledby="principles-title">
        <h2 id="principles-title" data-i18n="about.principles">Operating Principles</h2>
        <div class="principles-grid">
          <article class="panel panel-soft">
            <h3 data-i18n="about.principle1Title">Codify repeatable operations</h3>
            <p data-i18n="about.principle1Desc">
              Every recurring action should move from ad-hoc command execution into tested
              automation.
            </p>
          </article>
          <article class="panel panel-soft">
            <h3 data-i18n="about.principle2Title">State the problem before the tool</h3>
            <p data-i18n="about.principle2Desc">
              Technology choices are justified by incident patterns, constraints, and measurable
              operational outcomes.
            </p>
          </article>
          <article class="panel panel-soft">
            <h3 data-i18n="about.principle3Title">Keep portfolio content safe</h3>
            <p data-i18n="about.principle3Desc">
              Write with practical depth while avoiding confidential architecture, identities, or
              customer-sensitive data.
            </p>
          </article>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
