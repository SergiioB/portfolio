---
import { getCollection } from "astro:content";

import ExecutiveSidebar from "../../components/ExecutiveSidebar.astro";
import HandbookMath from "../../components/HandbookMath.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const handbookEntries = await getCollection("handbook");

  // Sort entries to determine prev/next
  const sorted = handbookEntries.sort((a, b) => a.data.chapter - b.data.chapter);

  return sorted.map((entry, index) => {
    const prev = index > 0 ? sorted[index - 1] : null;
    const next = index < sorted.length - 1 ? sorted[index + 1] : null;

    return {
      params: { slug: entry.slug },
      props: { entry, prev, next },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();

const title = `Chapter ${entry.data.chapter}: ${entry.data.title}`;
---

<BaseLayout title={title} description={entry.data.description} layoutMode="executive">
  <div class="executive-home">
    <ExecutiveSidebar currentPath={Astro.url.pathname} />
    <main class="executive-main">
      <article class="handbook-content">
        <header class="article-header">
          <div class="meta-row">
            <a href="/handbook/" class="back-link">← Back to Handbook</a>
            <span class="part-label">{entry.data.part}</span>
          </div>
          <h1 class="chapter-title">
            <span class="chapter-num">Chapter {entry.data.chapter}</span>
            {entry.data.title}
          </h1>
          <p class="description">{entry.data.description}</p>
        </header>

        <div class="prose">
          <Content />
        </div>

        <footer class="chapter-nav">
          {
            prev && (
              <a href={`/handbook/${prev.slug}/`} class="nav-prev card">
                <span class="nav-label">← Previous Chapter</span>
                <span class="nav-title">{prev.data.title}</span>
              </a>
            )
          }
          {!prev && <div />}

          {
            next && (
              <a href={`/handbook/${next.slug}/`} class="nav-next card">
                <span class="nav-label">Next Chapter →</span>
                <span class="nav-title">{next.data.title}</span>
              </a>
            )
          }
        </footer>
      </article>
    </main>
  </div>
  <HandbookMath />
</BaseLayout>

<style>
  .handbook-content {
    max-width: 980px;
    margin: 0 auto;
  }

  .article-header {
    position: relative;
    overflow: hidden;
    margin-bottom: var(--space-2xl);
    padding: clamp(1.35rem, 3vw, 2.4rem);
    border: 1px solid rgba(88, 166, 255, 0.22);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 10% 10%, rgba(88, 166, 255, 0.16), transparent 30%),
      linear-gradient(135deg, var(--hero-grad-from), var(--surface));
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .back-link,
  .part-label {
    color: #58a6ff;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--heading);
  }

  .chapter-title {
    margin: 0 0 var(--space-md);
    color: var(--heading);
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .chapter-num {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .description {
    max-width: 760px;
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .prose {
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .prose :global(h2) {
    margin: 2.2rem 0 0.9rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
    color: var(--heading);
    font-size: 1.4rem;
    line-height: 1.25;
  }

  .prose :global(h3) {
    margin: 1.7rem 0 0.7rem;
    color: var(--heading);
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .prose :global(h2):first-child,
  .prose :global(h3):first-child {
    margin-top: 0.25rem;
  }

  .prose :global(p) {
    margin: 0 0 1.05rem;
    line-height: 1.7;
    color: var(--text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.05rem;
    padding-left: 1.3rem;
    line-height: 1.7;
    color: var(--text);
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    max-width: 640px;
    margin: 1.4rem auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: #0d1117;
  }

  .chapter-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  .nav-prev,
  .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }

  .nav-prev:hover,
  .nav-next:hover {
    transform: translateY(-2px);
    border-color: rgba(88, 166, 255, 0.42);
  }

  .nav-next {
    text-align: right;
  }

  .nav-label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .nav-title {
    color: var(--heading);
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  @media (max-width: 640px) {
    .meta-row {
      align-items: flex-start;
      flex-direction: column;
    }
    .chapter-nav {
      grid-template-columns: 1fr;
    }
    .nav-next {
      text-align: left;
    }
  }
</style>
