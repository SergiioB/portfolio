---
import { getCollection } from "astro:content";

import { SITE } from "../../config/site";
import { getCategoryLabel } from "../../content/categories";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../utils/paths";
import { estimateReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const {
  title,
  description,
  pubDate,
  category,
  tags,
  updatedDate,
  situation,
  issue,
  solution,
  usedIn,
  impact,
  amazonUrl,
} = post.data;
const readingTime = estimateReadingTime(post.body);
const primaryCategory = category[0]; // First category is primary for breadcrumb

const caseItems = [
  { label: "Situation", labelKey: "posts.situation", value: situation },
  { label: "Issue:", labelKey: "posts.issue", value: issue },
  { label: "Solution:", labelKey: "posts.solution", value: solution },
  { label: "Used In:", labelKey: "posts.usedIn", value: usedIn },
  { label: "Impact:", labelKey: "posts.impact", value: impact },
].filter((item) => item.value);
---

<BaseLayout title={`${title} | ${SITE.author}`} description={description}>
  <a
    href={withBase()}
    class="btn btn-secondary"
    style="margin-bottom: 2rem; border-radius: 999px; font-size: 0.8rem; padding: 0.45rem 1rem;"
    data-i18n="nav.backToPosts">← Back to posts</a
  >

  <article class="article-shell">
    <header class="article-header">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase()} data-i18n="nav.breadcrumbHome">Home</a>
        <span>/</span>
        <a href={withBase(`${primaryCategory}/`)} data-i18n={`cat.${primaryCategory}`}>
          {getCategoryLabel(primaryCategory)}
        </a>
        {
          category.length > 1 && (
            <>
              <span>/</span>
              <span class="category-tags">
                {category.slice(1).map((cat, i) => (
                  <>
                    {i > 0 && ", "}
                    <a
                      href={withBase(`${cat}/`)}
                      class="secondary-category"
                      data-i18n={`cat.${cat}`}
                    >
                      {getCategoryLabel(cat)}
                    </a>
                  </>
                ))}
              </span>
            </>
          )
        }
      </nav>

      <div class="article-meta">
        <time datetime={pubDate.toISOString()} data-localize-date="full">
          {
            pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
        <span aria-hidden="true">•</span>
        <span>{readingTime} <span data-i18n="posts.minRead">min read</span></span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">•</span>
              <span>
                <span data-i18n="posts.updated">Updated</span>{" "}
                <time datetime={updatedDate.toISOString()} data-localize-date="numeric">
                  {updatedDate.toLocaleDateString("en-US")}
                </time>
              </span>
            </>
          )
        }
      </div>

      <h1 class="article-title">{title}</h1>
      <p class="page-description">{description}</p>

      {
        tags && tags.length > 0 && (
          <div class="post-tags post-tags-spaced" aria-label="Post tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      caseItems.length > 0 && (
        <section class="case-snapshot panel panel-soft" aria-label="Case snapshot">
          <h2 data-i18n="post.caseSnapshot">Case Snapshot</h2>
          <div class="case-grid">
            {caseItems.map((item) => (
              <article class="case-card">
                <h3 data-i18n={item.labelKey}>{item.label}</h3>
                <p>{item.value}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      amazonUrl && (
        <div class="amazon-cta amazon-cta-top">
          <a
            href={amazonUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="amazon-cta-btn"
          >
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="9" cy="21" r="1" />
              <circle cx="20" cy="21" r="1" />
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
            </svg>
            <span>Buy on Amazon</span>
          </a>
        </div>
      )
    }

    <div class="article-content prose-shell">
      <Content />
    </div>

    {
      amazonUrl && (
        <div class="amazon-cta">
          <a
            href={amazonUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="amazon-cta-btn"
          >
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="9" cy="21" r="1" />
              <circle cx="20" cy="21" r="1" />
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
            </svg>
            <span>Buy on Amazon</span>
          </a>
          <p class="amazon-cta-disclosure">
            As an Amazon Associate I earn from qualifying purchases.
          </p>
        </div>
      )
    }

    <footer class="article-footer">
      <a href={withBase("archive/")} class="back-link" data-i18n="nav.browseArchive"
        >← Browse archive</a
      >
    </footer>
  </article>
</BaseLayout>
