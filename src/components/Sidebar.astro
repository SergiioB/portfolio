---
import { getCollection } from "astro:content";

import { SITE } from "../config/site";
import { CATEGORY_META, CATEGORY_ORDER, categoryMatches } from "../content/categories";
import { withBase } from "../utils/paths";

const posts = await getCollection("posts");
const publishedPosts = posts.filter((post) => !post.data.draft);

const categoryCounts = CATEGORY_ORDER.map((category) => ({
  slug: category,
  label: CATEGORY_META[category].label,
  count: publishedPosts.filter((post) => categoryMatches(post.data.category, category)).length,
})).filter((cat) => cat.count > 0);

const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
  if (path === withBase()) {
    return (
      currentPath === withBase() || currentPath === "/portfolio/" || currentPath === "/portfolio"
    );
  }
  return currentPath.startsWith(path);
}
---

<aside class="sidebar" id="site-sidebar" data-sidebar>
  <div class="sidebar-header">
    <a href={withBase()} class="site-brand">
      <span class="brand-name" data-i18n="site.brand">{SITE.brand}</span>
      <span class="brand-role" data-i18n="site.role">{SITE.role}</span>
    </a>
    <p class="sidebar-summary" data-i18n="site.profileSummary">{SITE.profileSummary}</p>
    <div class="sidebar-language-switcher">
      <span class="sidebar-language-label" data-i18n="lang.label">Language</span>
      <div
        class="lang-switcher-pill"
        role="group"
        aria-label="Language"
        data-i18n-label="lang.label"
      >
        <button
          type="button"
          class="lang-btn active"
          data-lang="en"
          data-lang-option="en"
          aria-pressed="true"
          title="English"
        >
          EN
        </button>
        <button
          type="button"
          class="lang-btn"
          data-lang="es"
          data-lang-option="es"
          aria-pressed="false"
          title="Español"
        >
          ES
        </button>
      </div>
      <div class="theme-toggle-container" style="margin-left: 1rem;">
        <button
          type="button"
          class="theme-toggle-btn"
          aria-label="Toggle theme"
          title="Toggle Light/Dark Mode"
        >
          <svg
            class="sun-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="display: none;"
            ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"
            ></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"
            ></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path
              d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg
          >
          <svg
            class="moon-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="display: block;"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
          >
        </button>
      </div>
    </div>
  </div>

  <nav class="sidebar-nav" aria-label="Primary navigation">
    <div class="nav-section">
      <div class="nav-section-title" data-i18n="nav.portfolio">Portfolio</div>
      <ul class="nav-list">
        <li class="nav-item">
          <a
            href={withBase()}
            class:list={["nav-link", { active: isActive(withBase()) }]}
            data-i18n="nav.home">Home</a
          >
        </li>
        <li class="nav-item">
          <a
            href={withBase("archive/")}
            class:list={["nav-link", { active: isActive(withBase("archive/")) }]}
            data-i18n="nav.archive">Archive</a
          >
        </li>
        <li class="nav-item">
          <a
            href={withBase("about/")}
            class:list={["nav-link", { active: isActive(withBase("about/")) }]}
            data-i18n="nav.about">About + CV</a
          >
        </li>
        <li class="nav-item">
          <a
            href={withBase("handbook/")}
            class:list={["nav-link", { active: isActive(withBase("handbook/")) }]}>LLM Handbook</a
          >
        </li>
      </ul>
    </div>

    <div class="nav-section">
      <div class="nav-section-title" data-i18n="nav.domains">Domains</div>
      <ul class="nav-list">
        {
          categoryCounts.map((cat) => (
            <li class="nav-item">
              <a href={withBase(`${cat.slug}/`)} class={`nav-link category-${cat.slug}`}>
                <span class="nav-link-label" data-i18n={`cat.${cat.slug}`}>
                  {cat.label}
                </span>
                <span class="nav-link-count">{cat.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</aside>

<style>
  .theme-toggle-btn {
    background: transparent;
    border: none;
    color: var(--text-soft);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .theme-toggle-btn:hover {
    color: var(--heading);
    background: var(--surface-muted);
  }

  html[data-theme="dark"] .moon-icon {
    display: none !important;
  }

  html[data-theme="dark"] .sun-icon {
    display: block !important;
  }
</style>

<script is:inline>
  function setupThemeToggle() {
    const themeBtns = document.querySelectorAll(".theme-toggle-btn");

    themeBtns.forEach((btn) => {
      // Remove old listeners by cloning
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);

      newBtn.addEventListener("click", () => {
        const root = document.documentElement;
        const currentTheme = root.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        root.setAttribute("data-theme", newTheme);
        localStorage.setItem("theme", newTheme);
      });
    });
  }

  // Run on first load
  setupThemeToggle();

  // Run on view transitions
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>

<header class="mobile-header">
  <button
    class="menu-toggle"
    type="button"
    data-menu-toggle
    aria-label="Toggle navigation"
    data-i18n-label="nav.menuLabel"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
      ><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"></path></svg
    >
  </button>
  <a href={withBase()} class="mobile-brand" data-i18n="site.brand">{SITE.brand}</a>
</header>
