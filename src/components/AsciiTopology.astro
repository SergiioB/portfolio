---
const nodes = [
  {
    id: "platform",
    label: "RHEL",
    eyebrow: "PLATFORM",
    titleEn: "Enterprise Linux",
    titleEs: "Linux empresarial",
    detailEn:
      "Lifecycle, automation, hardening, HA and the operational work that keeps platforms predictable.",
    detailEs:
      "Ciclo de vida, automatización, hardening, HA y el trabajo operativo que mantiene las plataformas predecibles.",
    cx: 400,
    cy: 130,
  },
  {
    id: "edge",
    label: "RK3588",
    eyebrow: "EDGE",
    titleEn: "Local inference",
    titleEs: "Inferencia local",
    detailEn:
      "Small ARM systems, llama.cpp experiments and practical limits measured on real hardware.",
    detailEs:
      "Sistemas ARM compactos, experimentos con llama.cpp y límites prácticos medidos en hardware real.",
    cx: 190,
    cy: 320,
  },
  {
    id: "gpu",
    label: "B70",
    eyebrow: "ACCELERATOR",
    titleEn: "AI infrastructure",
    titleEs: "Infraestructura de IA",
    detailEn:
      "Memory layout, KV cache, quantization and throughput tested as one complete serving system.",
    detailEs:
      "Memoria, KV cache, cuantización y throughput probados como un sistema completo de serving.",
    cx: 610,
    cy: 320,
  },
  {
    id: "apps",
    label: "KOTLIN",
    eyebrow: "PRODUCT",
    titleEn: "Production apps",
    titleEs: "Apps en producción",
    detailEn:
      "Local-first Android products that turn engineering decisions into something people can use.",
    detailEs:
      "Productos Android local-first que convierten decisiones de ingeniería en herramientas que la gente puede usar.",
    cx: 400,
    cy: 500,
  },
];

const connections = [
  { from: "platform", to: "edge" },
  { from: "platform", to: "gpu" },
  { from: "edge", to: "apps" },
  { from: "gpu", to: "apps" },
];
---

<section class="topology-console" data-topology-console aria-labelledby="topology-console-title">
  <div class="topology-console-bar">
    <div class="topology-console-lights" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <p id="topology-console-title">system_map://sergiiob.dev</p>
    <span class="topology-console-status"
      ><i></i> <span data-i18n="exec.mapLive">interactive</span></span
    >
  </div>

  <div class="topology-stage" data-topology-stage>
    <svg
      class="topology-svg"
      viewBox="0 0 800 560"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <pattern id="dotGrid" width="32" height="32" patternUnits="userSpaceOnUse">
          <circle cx="16" cy="16" r="0.8" fill="currentColor" opacity="0.12"></circle>
        </pattern>
      </defs>

      <rect width="800" height="560" fill="url(#dotGrid)"></rect>

      {/* Connection lines: dotted/dashed, thin */}
      <g class="topology-connections">
        {
          connections.map((conn) => {
            const from = nodes.find((n) => n.id === conn.from)!;
            const to = nodes.find((n) => n.id === conn.to)!;
            return (
              <g
                class={`topology-link topology-link-${conn.from}-${conn.to}`}
                data-link-from={conn.from}
                data-link-to={conn.to}
              >
                <line
                  x1={from.cx}
                  y1={from.cy}
                  x2={to.cx}
                  y2={to.cy}
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-dasharray="2 6"
                  opacity="0.35"
                  stroke-linecap="round"
                />
                <circle r="2.5" fill="currentColor" opacity="0.6" class="topology-pulse">
                  <animateMotion
                    dur="3s"
                    repeatCount="indefinite"
                    path={`M ${from.cx} ${from.cy} L ${to.cx} ${to.cy}`}
                  />
                </circle>
              </g>
            );
          })
        }
      </g>

      {/* Nodes: circles with dotted rings */}
      <g class="topology-nodes">
        {
          nodes.map((node, i) => (
            <g
              class={`topology-node topology-node-${node.id}`}
              data-topology-node={node.id}
              data-eyebrow={node.eyebrow}
              data-title-en={node.titleEn}
              data-title-es={node.titleEs}
              data-detail-en={node.detailEn}
              data-detail-es={node.detailEs}
              data-index={i}
              role="button"
              tabindex="0"
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {/* Outer dotted ring */}
              <circle
                cx={node.cx}
                cy={node.cy}
                r="78"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-dasharray="1 4"
                opacity="0.25"
                class="topology-node-ring"
              />
              {/* Inner solid circle */}
              <circle
                cx={node.cx}
                cy={node.cy}
                r="54"
                fill="var(--field-paper)"
                stroke="currentColor"
                stroke-width="1.5"
                opacity="0.8"
                class="topology-node-core"
              />
              {/* Status dot */}
              <circle
                cx={node.cx}
                cy={node.cy - 22}
                r="2.5"
                fill="var(--field-green)"
                class="topology-node-status"
              >
                <animate
                  attributeName="opacity"
                  values="0.4;1;0.4"
                  dur="2s"
                  repeatCount="indefinite"
                />
              </circle>
              {/* Node label */}
              <text
                x={node.cx}
                y={node.cy + 4}
                text-anchor="middle"
                fill="currentColor"
                font-size="17"
                font-weight="600"
                font-family="var(--font-mono)"
                letter-spacing="0.5"
                class="topology-node-label"
              >
                {node.label}
              </text>
              {/* Node eyebrow below */}
              <text
                x={node.cx}
                y={node.cy + 18}
                text-anchor="middle"
                fill="currentColor"
                font-size="11"
                font-family="var(--font-mono)"
                opacity="0.5"
                letter-spacing="1"
                class="topology-node-eyebrow"
              >
                {node.eyebrow}
              </text>
            </g>
          ))
        }
      </g>
    </svg>

    <div class="topology-readout" aria-live="polite">
      <div class="topology-readout-meta">
        <span class="topology-readout-index">01 / 04</span>
        <span class="topology-readout-eyebrow">PLATFORM</span>
      </div>
      <strong class="topology-readout-title">Enterprise Linux</strong>
      <p class="topology-readout-detail">
        Lifecycle, automation, hardening, HA and the operational work that keeps platforms
        predictable.
      </p>
    </div>

    <div class="topology-console-hint">
      <span data-i18n="exec.mapHint">Select a node to inspect the system</span>
      <span aria-hidden="true">↗ interactive</span>
    </div>
  </div>
</section>

<script>
  const bindTopologyConsoles = () => {
    document.querySelectorAll<HTMLElement>("[data-topology-console]").forEach((consoleEl) => {
      if (consoleEl.dataset.bound === "1") return;
      consoleEl.dataset.bound = "1";

      const nodeEls = Array.from(consoleEl.querySelectorAll<HTMLElement>("[data-topology-node]"));
      const index = consoleEl.querySelector<HTMLElement>(".topology-readout-index");
      const eyebrow = consoleEl.querySelector<HTMLElement>(".topology-readout-eyebrow");
      const title = consoleEl.querySelector<HTMLElement>(".topology-readout-title");
      const detail = consoleEl.querySelector<HTMLElement>(".topology-readout-detail");
      const linkEls = consoleEl.querySelectorAll<HTMLElement>(".topology-link");

      const currentLang = () => (localStorage.getItem("portfolio.lang") === "es" ? "es" : "en");

      const activate = (node: HTMLElement, nodeIndex: number) => {
        nodeEls.forEach((candidate) => {
          const active = candidate === node;
          candidate.classList.toggle("is-active", active);
          candidate.setAttribute("aria-pressed", active ? "true" : "false");
        });

        // Highlight connected links
        const activeId = node.dataset.topologyNode;
        linkEls.forEach((link) => {
          const from = link.dataset.linkFrom;
          const to = link.dataset.linkTo;
          link.classList.toggle("is-active", from === activeId || to === activeId);
        });

        const lang = currentLang();
        if (index) index.textContent = `${String(nodeIndex + 1).padStart(2, "0")} / 04`;
        if (eyebrow) eyebrow.textContent = node.dataset.eyebrow ?? "SYSTEM";
        if (title)
          title.textContent =
            lang === "es" ? (node.dataset.titleEs ?? "") : (node.dataset.titleEn ?? "");
        if (detail)
          detail.textContent =
            lang === "es" ? (node.dataset.detailEs ?? "") : (node.dataset.detailEn ?? "");
      };

      nodeEls.forEach((node, nodeIndex) => {
        node.addEventListener("click", () => activate(node, nodeIndex));
        node.addEventListener("pointerenter", () => activate(node, nodeIndex));

        node.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            activate(node, nodeIndex);
          }
        });
      });

      // Auto-cycle on desktop
      let autoCycle: number | null = null;
      let cycleIndex = 0;
      const startAutoCycle = () => {
        if (autoCycle) return;
        autoCycle = window.setInterval(() => {
          cycleIndex = (cycleIndex + 1) % nodeEls.length;
          activate(nodeEls[cycleIndex], cycleIndex);
        }, 3500);
      };
      const stopAutoCycle = () => {
        if (autoCycle) {
          clearInterval(autoCycle);
          autoCycle = null;
        }
      };

      if (window.matchMedia("(hover: hover)").matches) {
        setTimeout(startAutoCycle, 1500);
      }

      consoleEl.addEventListener("pointerenter", stopAutoCycle, { once: true });
      consoleEl.addEventListener("click", stopAutoCycle, { once: true });

      window.addEventListener("portfolio-lang-change", () => {
        const activeIndex = Math.max(
          0,
          nodeEls.findIndex((n) => n.classList.contains("is-active"))
        );
        if (nodeEls[activeIndex]) activate(nodeEls[activeIndex], activeIndex);
      });
    });
  };

  bindTopologyConsoles();
  document.addEventListener("astro:page-load", bindTopologyConsoles);
</script>

<style>
  .topology-console {
    border: 1px solid var(--field-line-strong);
    border-radius: 1rem;
    background: var(--field-paper);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
  }

  .topology-console-bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: center;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--field-line);
    background: var(--field-paper-strong);
  }

  .topology-console-bar p,
  .topology-console-status {
    margin: 0;
    color: var(--field-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
  }

  .topology-console-status {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }

  .topology-console-status i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--field-green);
    animation: pulse 2s ease-in-out infinite;
  }

  .topology-console-lights {
    display: flex;
    gap: 0.28rem;
  }

  .topology-console-lights span {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--field-line-strong);
  }

  .topology-console-lights span:first-child {
    background: #e1725e;
  }
  .topology-console-lights span:nth-child(2) {
    background: #d5a542;
  }
  .topology-console-lights span:last-child {
    background: var(--field-green);
  }

  .topology-stage {
    position: relative;
    aspect-ratio: 10 / 7;
    background: var(--field-paper-strong);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .topology-svg {
    flex: 1;
    width: 100%;
    color: var(--field-ink);
    min-height: 0;
  }

  /* Node interactions */
  .topology-node {
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .topology-node:hover .topology-node-core,
  .topology-node.is-active .topology-node-core {
    fill: var(--field-accent-soft);
    stroke-width: 2;
    opacity: 1;
  }

  .topology-node:hover .topology-node-ring,
  .topology-node.is-active .topology-node-ring {
    opacity: 0.6;
    stroke-width: 1.5;
  }

  .topology-node:hover .topology-node-label,
  .topology-node.is-active .topology-node-label {
    font-weight: 700;
  }

  .topology-node.is-active .topology-node-ring {
    animation: ring-pulse 1.5s ease-in-out infinite;
  }

  /* Link active state */
  .topology-link.is-active line {
    opacity: 0.7;
    stroke-width: 2;
  }

  .topology-link.is-active .topology-pulse {
    opacity: 1;
  }

  /* Readout panel */
  .topology-readout {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem 1rem;
    align-items: center;
    padding: 0.8rem 1.2rem;
    border-top: 1px solid var(--field-line);
    background: var(--field-paper);
  }

  .topology-readout-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    grid-row: span 2;
  }

  .topology-readout-index {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    color: var(--field-muted);
    letter-spacing: 0.05em;
  }

  .topology-readout-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    color: var(--field-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .topology-readout-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--field-ink);
    line-height: 1.2;
  }

  .topology-readout-detail {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--field-muted);
    max-width: 46ch;
  }

  .topology-console-hint {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.45rem 1.2rem;
    border-top: 1px solid var(--field-line);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    color: var(--field-muted);
    letter-spacing: 0.04em;
  }

  /* Animations */
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes ring-pulse {
    0%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0.4;
    }
    50% {
      stroke-dashoffset: 20;
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topology-pulse,
    .topology-node-status animate,
    .topology-console-status i {
      animation: none !important;
    }
    .topology-node.is-active .topology-node-ring {
      animation: none !important;
    }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .topology-stage {
      aspect-ratio: 1 / 1;
      min-height: 300px;
    }

    .topology-readout {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 0.7rem 1rem;
    }

    .topology-readout-meta {
      flex-direction: row;
      gap: 0.6rem;
      grid-row: auto;
    }

    .topology-readout-title {
      font-size: 0.85rem;
    }

    .topology-readout-detail {
      font-size: 0.68rem;
    }

    .topology-console-hint {
      font-size: 0.46rem;
    }
  }
</style>
