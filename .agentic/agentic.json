{
  "version": 1,
  "project_name": "portfolio",
  "project_type": "Astro/TypeScript",
  "source_roots": ["src", "scripts", "tests"],
  "module_agent_dirs": [
    "src",
    "src/components",
    "src/config",
    "src/content",
    "src/layouts",
    "src/pages",
    "src/styles",
    "src/utils",
    "scripts",
    "public",
    "tests",
    "docs",
    "agent"
  ],
  "ignore_dirs": [
    ".aider.tags.cache.v4",
    ".astro",
    ".astro.bak-*",
    ".cache",
    ".codex-tmp",
    ".firebase",
    ".git",
    ".gradle",
    ".hg",
    ".idea",
    ".kotlin",
    ".mypy_cache",
    ".next",
    ".pytest_cache",
    ".reports",
    ".ruff_cache",
    ".stfolder",
    ".stfolder.removed-*",
    ".stfolder.removed-20260219-200342",
    ".svn",
    ".venv",
    "__pycache__",
    "backup",
    "build",
    "cmdline-tools",
    "coverage",
    "dist",
    "logs",
    "models",
    "node_modules",
    "playwright-report",
    "reports",
    "sessions",
    "temp_sqlcipher",
    "test-results",
    "third_party",
    "venv"
  ],
  "rules": {
    "max_file_lines": 300,
    "max_dir_files": 30,
    "ban_ts_any": true,
    "scan_obvious_secrets": true,
    "require_module_agents": true
  }
}
